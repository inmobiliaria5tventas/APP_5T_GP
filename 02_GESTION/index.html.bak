                <button type="button" id="btn-toggle-3d" onclick="window.APP5T_Map3D && window.APP5T_Map3D.toggle3D()" class="btn-3d-toggle" style="display: inline-flex; padding: 0 12px; height: 38px; align-items: center; justify-content: center; gap: 6px; border: 1px solid #00e5ff; color: #00e5ff; background: rgba(0, 229, 255, 0.08); font-weight: 700; cursor: pointer; border-radius: var(--radius-sm); font-size: 0.82rem; box-shadow: 0 2px 8px rgba(0,229,255,0.2);" title="Alternar Vista 3D con Relieve (Modo PC)">
                  <i class="fa-solid fa-cube"></i> <span id="lbl-toggle-3d">Vista 3D</span>
