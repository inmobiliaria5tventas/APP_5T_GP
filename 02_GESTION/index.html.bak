                  <label style="font-weight: 600; color: var(--text-dim); font-size: 0.75rem; text-transform: uppercase;">AÃ±o:</label>
                  <select id="informes-filter-anio" class="form-control" style="width: 120px;   border: 1px solid var(--glass-border); padding: 6px 12px; border-radius: 4px; height: 38px;">
