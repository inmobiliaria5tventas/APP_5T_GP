                    <span id="lote-status-badge" class="status-badge">--</span>
                    <button type="button" onclick="if(window.APP5T && window.APP5T.clearLoteSelection) window.APP5T.clearLoteSelection();" title="Cerrar Ficha" style="background:transparent; border:none; color:var(--text-dim); cursor:pointer; font-size:1.1rem; padding:2px 6px; border-radius:4px; transition:color 0.2s;" onmouseover="this.style.color='var(--text-white)'" onmouseout="this.style.color='var(--text-dim)'"><i class="fa-solid fa-xmark"></i></button>
                  </div>
