                <button type="button" id="btn-3d-orbit" onclick="window.APP5T_Map3D && window.APP5T_Map3D.toggleCinematicOrbit()" style="background: rgba(16, 185, 129, 0.15); border: 1px solid #10b981; color: #10b981; font-weight: 700; font-size: 0.76rem; padding: 5px 10px; border-radius: 6px; cursor: pointer; display: inline-flex; align-items: center; gap: 5px;">
                  <i class="fa-solid fa-video"></i> Giro 360Â°
