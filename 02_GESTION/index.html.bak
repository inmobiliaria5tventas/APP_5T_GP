      <div class="modal-body" style="padding: 16px;">
        <p class="card-subtitle" style="margin-bottom:16px;">Lotes solicitados que esperan aprobaciÃ³n del Gerente.</p>
        <div class="table-responsive">
          <table class="premium-table">
            <thead>
              <tr>
                <th>Lote</th>
                <th>Proyecto</th>
                <th>Fecha Solicitud</th>
                <th>Tipo</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody id="tbody-pending-approvals">
              <!-- Rows injected by JS -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Theme logic
    document.addEventListener('DOMContentLoaded', () => {
      const themeToggle = document.getElementById('theme-toggle');
      if (!themeToggle) return;
      
      const currentTheme = localStorage.getItem('app5t_theme');
      if (currentTheme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
        themeToggle.innerHTML = '<i class="fa-solid fa-sun"></i> Modo Claro';
      }

      themeToggle.addEventListener('click', () => {
        let theme = document.documentElement.getAttribute('data-theme');
        if (theme === 'dark') {
          document.documentElement.removeAttribute('data-theme');
          localStorage.setItem('app5t_theme', 'light');
          themeToggle.innerHTML = '<i class="fa-solid fa-moon"></i> Modo Oscuro';
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
          localStorage.setItem('app5t_theme', 'dark');
          themeToggle.innerHTML = '<i class="fa-solid fa-sun"></i> Modo Claro';
        }
      });
    });
  </script>
    <!-- Modal Reprogramaciï¿½n Deuda -->
  
  </div>
<div class="modal-overlay" id="modal-reprogramacion" onclick="if(event.target===this) this.classList.remove('visible')">
    <div class="modal-card" style="max-width: 600px;">
      <div class="modal-header">
        <h3><i class="fa-solid fa-calendar-alt" style="color:var(--accent-orange);"></i> Reprogramar Deuda</h3>
        <button class="btn btn-ghost" onclick="document.getElementById('modal-reprogramacion').classList.remove('visible')" style="font-size:1.2rem; padding:5px 10px;">&times;</button>
      </div>
      <div class="modal-body" style="padding: 20px;">
        <p style="color:var(--text-dim); margin-bottom: 20px;">Redefine el nÃºmero de cuotas para el saldo pendiente.</p>
        
        <div style="background: rgba(255,255,255,0.02); padding: 15px; border-radius: 8px; margin-bottom: 20px; border: 1px solid var(--glass-border);">
          <div style="display:flex; justify-content:space-between; margin-bottom: 10px;">
            <span style="color:var(--text-dim);">Saldo Pendiente:</span>
            <strong id="repro-saldo" style="color:var(--text-white); font-size: 1.1rem;">-</strong>
          </div>
          <div style="display:flex; justify-content:space-between;">
            <span style="color:var(--text-dim);">Cuotas Restantes Originales:</span>
            <strong id="repro-cuotas-originales" style="color:var(--text-light);">-</strong>
          </div>
        </div>

        <div class="form-grid">
          <div class="form-group">
            <label>Nuevo NÃºmero de Cuotas (del saldo)</label>
            <input type="number" id="repro-nuevas-cuotas" class="form-control" min="1" step="1" required>
          </div>
          <div class="form-group">
            <label>Fecha 1ra Cuota Nueva</label>
            <input type="date" id="repro-fecha-inicio" class="form-control" required>
          </div>
        </div>
        
        <input type="hidden" id="repro-id-propiedad">
        <input type="hidden" id="repro-id-cliente">
        
        <div style="margin-top: 25px; display: flex; gap: 10px; justify-content: flex-end;">
          <button type="button" class="btn btn-ghost" onclick="document.getElementById('modal-reprogramacion').classList.remove('visible')">Cancelar</button>
          <button type="button" class="btn btn-warning" onclick="APP5T_Forms._procesarReprogramacion(event)"><i class="fa-solid fa-check"></i> Aplicar ReprogramaciÃ³n</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('sw.js').catch(function(err) {
          console.log('SW registration notice:', err);
        });
      });
    }
  </script>
</body>
</html>




