        <div class="tab-panel" id="panel-catalogo">
          <div class="data-card">
            <h3 class="card-title">CatÃ¡logo Documental</h3>
            <p class="card-subtitle">AuditorÃ­a de expedientes digitales y enlaces a Google Drive</p>

            <div class="filters-row" style="margin-top: 15px; display: flex; gap: 10px; align-items: center;">
              <select id="filtro-catalogo-proyecto" class="form-select form-select-sm" style="max-width: 250px;" onchange="window.APP5T.filterCatalogo()">
                <option value="all">Todos los proyectos</option>
