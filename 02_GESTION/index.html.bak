        <div class="tab-panel" id="panel-dashboard">

          <!-- TÃ­tulo Dashboard Gerencia -->
          <div class="dashboard-gerencia-header role-chart role-gerente role-administrador" style="display:none; margin-bottom: 20px;">
            <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
              <h2 style="font-size: 24px; font-weight: 700; color:#ffffff; margin: 0;">RESUMEN COMERCIAL</h2>
