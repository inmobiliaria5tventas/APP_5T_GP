                </div>
                <div class="chart-wrapper">
                  <canvas id="chart-evolucion-ventas"></canvas>
                </div>
              </div>

            </div>

            <!-- Fila 3: GrÃ¡ficos Financieros -->
            <div class="charts-row gerencia-grid-row-3 role-chart role-gerente" style="display:none; margin-bottom:20px; margin-top:20px;">
              
              <!-- Cobranza del Mes -->
              <div class="chart-card">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                  <h3 class="chart-title" style="margin-bottom:0; text-transform:uppercase; font-size:12px; color:#ffffff;">Cobranza del Mes</h3>
                  <select id="filter-year-cobranza" class="year-filter-select" style="font-size: 0.8rem; padding: 2px 5px; border-radius: 4px; border: 1px solid #ddd; background: #fff; cursor: pointer;  outline: none;"></select>
                </div>
                <div class="chart-wrapper">
                  <canvas id="chart-cobranza-mes-gerencia"></canvas>
                </div>
              </div>

              <!-- ProyecciÃ³n Flujo de Caja -->
              <div class="chart-card">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
