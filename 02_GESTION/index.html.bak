        <!--  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€” 
             TAB: Informes Mensuales (Administrador)
              â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  â€”  -->
        <div class="tab-panel" id="panel-informes">
          <!-- Selector de Informes -->
          <div style="display: flex; gap: 15px; border-bottom: 1px solid var(--glass-border); margin-bottom: 24px; padding-bottom: 1px; overflow-x: auto; white-space: nowrap;">
            <button class="settings-subtab active" id="btn-rep-promesas" data-report="promesas" style="background: transparent; border: none; border-bottom: 3px solid var(--primary); color: var(--text-white); padding: 12px 18px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem;">
              <i class="fa-solid fa-file-signature" style="color: var(--primary);"></i> Promesas y Escrituras
            </button>
            <button class="settings-subtab" id="btn-rep-ctacte" data-report="ctacte" style="background: transparent; border: none; border-bottom: 3px solid transparent; color: var(--text-dim); padding: 12px 18px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem;" onmouseover="this.style.color='var(--text-white)'" onmouseout="if(!this.classList.contains('active')) this.style.color='var(--text-dim)'">
              <i class="fa-solid fa-file-invoice-dollar"></i> Cuenta Corriente
            </button>
            <button class="settings-subtab" id="btn-rep-ventas" data-report="ventas" style="background: transparent; border: none; border-bottom: 3px solid transparent; color: var(--text-dim); padding: 12px 18px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem;" onmouseover="this.style.color='var(--text-white)'" onmouseout="if(!this.classList.contains('active')) this.style.color='var(--text-dim)'">
              <i class="fa-solid fa-chart-line"></i> Ventas por Vendedor
            </button>
            <button class="settings-subtab" id="btn-rep-cuotas" data-report="cuotas" style="background: transparent; border: none; border-bottom: 3px solid transparent; color: var(--text-dim); padding: 12px 18px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem;" onmouseover="this.style.color='var(--text-white)'" onmouseout="if(!this.classList.contains('active')) this.style.color='var(--text-dim)'">
              <i class="fa-solid fa-clock-rotate-left"></i> Cuotas Vencidas / Por Vencer
            </button>
          </div>

          <!-- CONTENEDOR 1: Promesas y Escrituras -->
          <div id="report-promesas-container" class="report-container active">
            <div class="data-card">
              <div class="card-header-flex" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 20px;">
                <div>
