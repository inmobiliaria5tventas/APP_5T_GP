                  <p class="card-subtitle">Control mensual consolidado y descarga de reportes</p>
                </div>
              <div style="display: flex; gap: 8px; align-items: center;">

                  <button class="btn btn-secondary" id="btn-export-pdf-promesas" style="display: flex; align-items: center; gap: 8px;">
                    <i class="fa-solid fa-file-pdf" style="color: var(--accent-orange);"></i> Exportar PDF
                  </button>
                  <button class="btn btn-secondary" id="btn-export-excel-promesas" style="display: flex; align-items: center; gap: 8px;">
