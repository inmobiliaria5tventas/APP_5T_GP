                    <span id="lote-price" class="spec-value">--</span>
                  </div>

                </div>
                <hr class="divider">
                <div id="lote-action-form">
                  <!-- Dynamic action form injected by JS based on role/status -->
                </div>
              </div>
            </div>

            <!-- Mobile: Bottom Sheet -->
