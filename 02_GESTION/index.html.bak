<div class="tab-panel" id="panel-ctacte">
          <div class="data-card">
            <div class="card-header-flex" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 20px;">
              <div>
                <h3 class="card-title">Cuenta Corriente</h3>
                <p class="card-subtitle">Control de cuotas y pagos</p>
              </div>
              <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                <div class="filter-group" style="display: flex; align-items: center; gap: 8px;">
                  <label for="ctacte-filter-cliente" style="font-weight: 500; color: var(--text-white); font-size: 0.9rem;">Filtrar por Cliente:</label>
                  <select id="ctacte-filter-cliente" class="form-control" style="width: 250px;   border: 1px solid var(--glass-border); padding: 6px 12px; border-radius: 4px;">
                    <option value="all">-- Todos los Clientes --</option>
                    <!-- Options injected by JS -->
                  </select>
                </div>
                <div class="filter-group" id="ctacte-filter-lote-group" style="display: none; align-items: center; gap: 8px;">
                  <label for="ctacte-filter-lote" style="font-weight: 500; color: var(--text-white); font-size: 0.9rem;">Seleccionar Lote:</label>
                  <select id="ctacte-filter-lote" class="form-control" style="width: 200px;   border: 1px solid var(--glass-border); padding: 6px 12px; border-radius: 4px;">
                    <option value="all">-- Todos los Lotes --</option>
                    <!-- Options injected by JS -->
                  </select>
                </div>
                <div id="ctacte-actions" style="display: none; align-items: center; gap: 8px;">
                  <button class="btn btn-warning btn-sm" onclick="APP5T_Forms.mostrarModalReprogramacion()" title="Reprogramar Deuda"><i class="fa-solid fa-calendar-alt"></i> Reprogramar</button>
                </div>
                <div id="ctacte-documents-container" class="dropdown" style="display: none; margin-left: 8px;">
                  <!-- Injected by JS -->
                </div>
              </div>
            </div>
            <div id="ctacte-summary-cards"></div>
            <div class="table-responsive">
              <table class="premium-table">
                <thead>
                  <tr>
                    <th>Cliente</th>
                    <th>Lote / Proyecto</th>
                    <th>Cuota Nº</th>
                    <th>Valor Cuota</th>
                    <th>Vencimiento</th>
                    <th>Pagado</th>
                    <th>Estado</th>
                    <th style="text-align:right">Acción</th>
                  </tr>
                </thead>
                <tbody id="tbody-ctacte">
                  <!-- Rows injected by JS -->
                </tbody>
              </table>
            </div>
          </div>
