  <div id="login-container" class="absolute top-0 left-0 w-full min-h-[100dvh] z-[99999] flex flex-col items-center justify-start pt-8 md:justify-center md:pt-0 bg-[#0a0e1a]/95 backdrop-blur-md transition-opacity duration-300">
