                    <i class="fa-solid fa-file-pdf" style="color: var(--accent-orange);"></i> Exportar PDF
                  </button>
                  <button class="btn btn-secondary" id="btn-export-excel-ctacte" style="display: flex; align-items: center; gap: 8px;">
                    <i class="fa-solid fa-file-excel" style="color: var(--accent-green);"></i> Exportar Excel
                  </button>
                </div>
              </div>
              <div style="display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 20px; align-items: flex-end;">
                <div class="filter-group" style="display: flex; flex-direction: column; gap: 6px;">
                  <label style="font-weight: 600; color: var(--text-dim); font-size: 0.75rem; text-transform: uppercase;">Cliente (RUT o Nombre):</label>
                  <input type="text" id="rep-ctacte-cliente" list="dl-ctacte-clientes" class="form-control" placeholder="Ej. 12345678-9" autocomplete="off" style="background-color: var(--glass-bg); color: var(--text-white); border: 1px solid var(--glass-border); padding: 6px 12px; border-radius: 4px; height: 38px;">
                  <datalist id="dl-ctacte-clientes"></datalist>
                </div>
                <div class="filter-group" style="display: flex; flex-direction: column; gap: 6px;">
                  <label style="font-weight: 600; color: var(--text-dim); font-size: 0.75rem; text-transform: uppercase;">Proyecto:</label>
                  <select id="rep-ctacte-proyecto" class="form-control" style="width: 150px;   border: 1px solid var(--glass-border); padding: 6px 12px; border-radius: 4px; height: 38px;">
                    <option value="all">-- Todos --</option>
