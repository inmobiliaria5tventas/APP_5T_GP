                  <i class="fa-solid fa-file-excel"></i> Excel
                </button>
                <button onclick="APP5T_Charts.exportChartReport('panel-dashboard', 'Resumen_Comercial_Completo')" style="background-color: #e74c3c; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-size: 14px; font-weight: 600; display:flex; align-items:center; gap:8px; box-shadow: 0 4px 6px rgba(231, 76, 60, 0.2); transition: background 0.2s;" onmouseover="this.style.backgroundColor='#c0392b';" onmouseout="this.style.backgroundColor='#e74c3c';" title="Descargar Informe Completo PDF">
