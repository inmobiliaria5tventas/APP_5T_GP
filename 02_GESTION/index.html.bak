                <button type="button" onclick="window.APP5T_Map3D && window.APP5T_Map3D.setPitchAngle(0)" style="background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.2); color: #fff; font-size: 0.74rem; padding: 5px 8px; border-radius: 6px; cursor: pointer;">
                  <i class="fa-solid fa-arrow-down"></i> Cenital
                </button>
              </div>
            </div>

